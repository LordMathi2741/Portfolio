---

import { certfieds } from "../../assets/data/certifieds";
import Carrousel from "../../components/Carrousel";
import DeveloperDescription from "../../components/DeveloperDescription.astro";
import Experience from "../../components/Experience";
import Footer from "../../components/Footer.astro";
import FormContact from "../../components/FormContact";
import NavBar from "../../components/NavBar.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/util";
import Layout from "../../layouts/Layout.astro";
import DataDetector from "../../utils/data-detector";


const lang = getLangFromUrl(Astro.url);

const t = useTranslations(lang);

const worksData = DataDetector.detect(lang)['works'];
const experiencesData = DataDetector.detect(lang)['experiences'];


---

<Layout>
	<NavBar />
	<div class="main__container">
		<hero class="developer__container">
			<div class="developer__content" aria-label="Developer Information">
				<img src="/images/lordmathi2741.jpeg" alt="LordMathi2741" style="width: 250px; height: 250px; border-radius: 50%; object-fit: cover; border: 4px solid var(--color-surface); box-shadow: var(--shadow-card);"/>
				<div class="developer__details">
					<h1>{t('dev.name')}</h1>
					<h2>{t('dev.title')}</h2>
					<div style="margin-top: 1.5rem; display: flex; gap: 1rem;">
						<a href="#work-section" style="background-color: var(--color-accent); color: white; padding: 12px 24px; border-radius: var(--radius-button); text-decoration: none; font-weight: 600; font-family: var(--font-body); transition: background-color 0.2s;">
							{t('works.button') || 'Ver proyectos'}
						</a>
						<a href="#contact-section" style="background-color: transparent; color: var(--color-text); border: 1px solid var(--color-border); padding: 12px 24px; border-radius: var(--radius-button); text-decoration: none; font-weight: 600; font-family: var(--font-body); transition: background-color 0.2s;">
							{t('contact.title') || 'Contacto'}
						</a>
					</div>
				</div>
			</div>
		</hero>

		<section id="about-section">
			<DeveloperDescription />
		</section>

		<section id="work-section">
			<h1>{t('works.title')}</h1>
			<Carrousel buttonLabel={t('works.button')} items={worksData} client:load />
		</section>
		<section id="experience-section">
			<h1>{t('experience.title')}</h1>
			<Experience data={experiencesData} />
		</section>
		<section id="achievements-section">
			<div>
				<h1>{t('achievements.title')}</h1>
				{certfieds.map((item, index) => (
					<div key={index} class="certification__content">
						<div class="certification__details">
							<h4>{item.title}</h4>
							<p>{item.description}</p>
						</div>
						<a href={item.url} target="_blank" rel="noopener noreferrer">
							<span class="material-icons">arrow_outward</span>
						</a>
					</div>
				))}
			</div>
		</section>
		<section id="contact-section" style="width: 100%">
			<h1>{t('contact.title')}</h1>
			<FormContact submitLabel={t('form.submit')} emailPlaceholder={t('form.email')} messagePlaceholder={t('form.message')} namePlaceholder={t('form.name')} client:load />
		</section>
		<section>
			<Footer />
		</section>
	</div>
</Layout>
