---
import { getLangFromUrl, useTranslations } from "../i18n/util";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---


<div>
    <hr />
    <footer class="footer-container">
        <h1> {t('footer.title')}</h1>
        <div class="footer-contact">
            <h4>{t('footer.content.title')} </h4>
            <h4> {t('footer.content.subtitle')}
                <a href="https://github.com/LordMathi2741">
                    Github
                </a> o contactarme a través de 
                <a href="https://www.linkedin.com/in/mathias-alejandro-jave-diaz-68a364222/">
                    Linkedln
                </a>
            </h4>
            <h4> &copy; {new Date().getFullYear()} Mathias Jave. {t('footer.copyrigth')}</h4>
        </div>
    </footer>
</div>

<style>

    hr {
        border: 0;
        height: 1px;
        background: var(--color-border);
    }

    .footer-container {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 2rem;
    }

    .footer-container h1 {
        font-family: var(--font-heading);
        font-size: 2.5rem;
        color: var(--color-accent);
    }

    .footer-contact {
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 2rem;
        width: 50%;
    }

    .footer-contact h4 {
        margin: 0.5rem;
        font-family: var(--font-body);
        color: var(--color-text);
        font-weight: 400;
    }

    .footer-contact a {
        color: var(--color-accent);
        text-decoration: none;
        font-weight: 600;
        &:hover {
            text-decoration: underline;
        }
    }

    @media (max-width: 768px) {
        .footer-container {
            flex-direction: column;
        }

        .footer-container h1 {
            width: 100%;
            text-align: center;
        }

        .footer-contact {
            width: 100%;
            text-align: center;
        }
    }

</style>