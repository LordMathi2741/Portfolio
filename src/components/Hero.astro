---
import { getLangFromUrl, useTranslations } from "../i18n/util";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const isEs = lang === 'es';
---

<section class="hero" aria-labelledby="hero-name">
    <div class="hero-text">
        <p class="hero-context">{t('hero.context')}</p>
        <p class="hero-role">{t('dev.title')}</p>
        <h1 id="hero-name">{t('dev.name')}</h1>
        <p class="hero-tagline">{t('hero.tagline')}</p>
        <p class="hero-metric">
            <span class="material-icons" aria-hidden="true">trending_up</span>
            {t('hero.metric')}
        </p>
        <div class="hero-ctas">
            <a href="#work-section" class="btn btn--primary">{t('hero.cta.works')}</a>
            <a href="#contact-section" class="btn btn--ghost">{t('hero.cta.contact')}</a>
        </div>
    </div>

    <div class="hero-side">
        <img src="/images/lordmathi2741.jpeg" alt={t('dev.name')} class="hero-photo" width="200" height="200" />
        <figure class="code-card card" aria-label="developer.ts">
            <figcaption class="code-title">
                <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
                developer.ts
            </figcaption>
<pre><code><span class="k">const</span> developer = {'{'}
  name: <span class="s">"Mathias Jave Diaz"</span>,
  university: <span class="s">"UPC"</span>,
  stack: [<span class="s">"C#"</span>, <span class="s">".NET"</span>, <span class="s">"Azure"</span>, <span class="s">"SQL Server"</span>],
  focus: [<span class="s">"Fintech"</span>, <span class="s">{isEs ? '"IA aplicada"' : '"Applied AI"'}</span>, <span class="s">{isEs ? '"Seguridad"' : '"Security"'}</span>],
  status: <span class="s">{isEs ? '"actualmente empleado"' : '"currently employed"'}</span>,
{'}'};</code></pre>
        </figure>
    </div>
</section>

<style>
    .hero {
        display: grid;
        grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
        align-items: center;
        gap: 3rem;
        padding-top: 80px;
    }

    .hero-context {
        margin: 0 0 1.25rem;
        color: var(--color-text-secondary);
        font-size: 0.9rem;
    }

    .hero-role {
        margin: 0;
        color: var(--color-accent-strong);
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-weight: 600;
    }

    :global([data-theme="dark"]) .hero-role {
        color: var(--color-accent);
    }

    h1 {
        margin: 0.25rem 0 1rem;
        font-size: clamp(2.5rem, 6vw, 3.5rem);
        line-height: 1.1;
        font-weight: 700;
    }

    .hero-tagline {
        max-width: 52ch;
        margin: 0 0 1.25rem;
        font-size: 1.15rem;
    }

    .hero-metric {
        display: flex;
        align-items: flex-start;
        gap: 0.5rem;
        max-width: 52ch;
        margin: 0 0 2rem;
        padding: 0.75rem 1rem;
        border-left: 3px solid var(--color-accent);
        background-color: var(--color-accent-bg);
        border-radius: 0 var(--radius-badge) var(--radius-badge) 0;
        font-size: 0.95rem;
    }

    .hero-metric .material-icons {
        color: var(--color-accent);
        font-size: 1.25rem;
    }

    .hero-ctas {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .hero-side {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.5rem;
    }

    .hero-photo {
        width: 200px;
        height: 200px;
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid var(--color-surface);
        box-shadow: var(--shadow-card-hover);
    }

    .code-card {
        width: 100%;
        margin: 0;
        overflow: hidden;
    }

    .code-title {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.6rem 1rem;
        border-bottom: 1px solid var(--color-border);
        color: var(--color-text-secondary);
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.8rem;
    }

    .dots {
        display: inline-flex;
        gap: 6px;
    }

    .dots i {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background-color: var(--color-border);
    }

    pre {
        margin: 0;
        padding: 1rem 1.25rem;
        overflow-x: auto;
        font-size: 0.85rem;
        line-height: 1.7;
        color: var(--color-text);
    }

    .k {
        color: var(--color-accent-strong);
        font-weight: 600;
    }

    .s {
        color: var(--color-text-secondary);
    }

    :global([data-theme="dark"]) .k {
        color: var(--color-accent);
    }

    @media (max-width: 900px) {
        .hero {
            grid-template-columns: 1fr;
            gap: 2rem;
            padding-top: 48px;
        }

        .hero-side {
            order: -1;
            align-items: flex-start;
        }

        .hero-photo {
            width: 120px;
            height: 120px;
        }

        .code-card {
            display: none;
        }
    }
</style>
