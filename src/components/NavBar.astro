---
import languages from "../assets/data/languages.js";
import { getLangFromUrl, useTranslations } from "../i18n/util";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const links = [
    { href: "#about-section", label: t('nav.about') },
    { href: "#experience-section", label: t('nav.experience') },
    { href: "#work-section", label: t('nav.works') },
    { href: "#stack-section", label: t('nav.stack') },
    { href: "#training-section", label: t('nav.training') },
    { href: "#contact-section", label: t('nav.contact') },
];
---

<header class="site-header">
    <nav class="nav" aria-label="Main">
        <a href={`/${lang}/`} class="logo">&lt; Mathias Jave /&gt;</a>

        <ul class="nav-links" id="nav-links">
            {links.map((link, index) => (
                <li>
                    <a href={link.href}>
                        <span class="nav-index">{String(index + 1).padStart(2, '0')}</span>
                        {link.label}
                    </a>
                </li>
            ))}
        </ul>

        <div class="nav-actions">
            <select class="select-lang" id="language-selector" aria-label="Language">
                {languages.map(language => (
                    <option value={language.value} selected={language.value === lang}>
                        {language.value.toUpperCase()}
                    </option>
                ))}
            </select>
            <a
                class="btn btn--primary download-btn"
                href="https://drive.google.com/file/d/1Vro7Lj0prsPxSOnsj9Y6c3yIdpbk7XB1/view?usp=sharing"
                target="_blank"
                rel="noopener"
            >
                {t('download')}
            </a>
            <button class="toggle-btn" id="nav-toggle" aria-label={t('nav.menu')} aria-expanded="false" aria-controls="nav-links">
                <span class="material-icons">menu</span>
            </button>
        </div>
    </nav>
</header>

<script>
    const selectLang = document.getElementById('language-selector') as HTMLSelectElement;
    const toggle = document.getElementById('nav-toggle')!;
    const links = document.getElementById('nav-links')!;

    selectLang.addEventListener('change', () => {
        const currentPath = window.location.pathname.split('/').slice(2).join('/');
        window.location.href = `/${selectLang.value}/${currentPath}`;
    });

    function setOpen(open: boolean) {
        links.classList.toggle('open', open);
        toggle.setAttribute('aria-expanded', String(open));
    }

    toggle.addEventListener('click', () => setOpen(!links.classList.contains('open')));
    links.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
</script>

<style>
    .site-header {
        position: sticky;
        top: 0;
        z-index: 100;
        background-color: var(--color-surface);
        border-bottom: 1px solid var(--color-border);
    }

    .nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        max-width: 1200px;
        margin: 0 auto;
        padding: 14px 24px;
    }

    .logo {
        color: var(--color-primary);
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-weight: 700;
        text-decoration: none;
        white-space: nowrap;
    }

    .nav-links {
        display: flex;
        gap: 1.25rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .nav-links a {
        display: inline-flex;
        align-items: baseline;
        gap: 0.35rem;
        color: var(--color-text);
        font-size: 0.9rem;
        font-weight: 500;
        text-decoration: none;
        transition: color 0.2s;
    }

    .nav-links a:hover {
        color: var(--color-accent);
    }

    .nav-index {
        color: var(--color-accent);
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.75rem;
    }

    .nav-actions {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .select-lang {
        min-height: 44px;
        padding: 0 0.5rem;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-button);
        background-color: transparent;
        color: var(--color-text);
        font-family: var(--font-body);
        font-weight: 600;
        cursor: pointer;
    }

    .select-lang option {
        background-color: var(--color-surface);
    }

    .toggle-btn {
        display: none;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-button);
        background-color: transparent;
        color: var(--color-text);
        cursor: pointer;
    }

    @media (max-width: 1024px) {
        .nav {
            position: relative;
            padding: 12px 16px;
        }

        .toggle-btn {
            display: inline-flex;
        }

        .nav-links {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            flex-direction: column;
            gap: 0;
            padding: 0.5rem 16px 1rem;
            background-color: var(--color-surface);
            border-bottom: 1px solid var(--color-border);
            box-shadow: var(--shadow-card-hover);
        }

        .nav-links.open {
            display: flex;
        }

        .nav-links a {
            width: 100%;
            min-height: 44px;
            align-items: center;
            font-size: 1rem;
        }
    }

    @media (max-width: 480px) {
        .download-btn {
            display: none;
        }
    }
</style>
